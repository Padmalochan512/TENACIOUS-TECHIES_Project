# Environment Configuration for Restaurant Support Agent
APP_ENV=development
APP_NAME=restaurant-support-agent
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Configuration (Google Gemini)
# Leave empty to automatically use MockLLMClient for offline testing/local dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Agent Configuration
MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=15
SESSION_MEMORY_MAX_MESSAGES=10

# RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=3

# Database & Storage
DATABASE_PATH=app/data/restaurant_support.db
LOG_LEVEL=INFO
TRACE_LOG_PATH=app/data/traces.jsonl
WORKFLOW_LOG_PATH=app/data/workflow_runs.jsonl

# Simulation Flags
SIMULATE_TOOL_FAILURE=false
SIMULATE_TIMEOUT=false
